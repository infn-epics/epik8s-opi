    <y>78</y>
    <width>130</width>
    <height>26</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>B</name>
    <text>Save/Restart</text>
    <actions>
      <action type="write_pv">
        <pv_name>$(P):RESTART</pv_name>
        <value>1</value>
        <description>Save/Restart</description>
      </action>
    </actions>
    <x>1090</x>
    <y>108</y>
    <width>130</width>
    <height>26</height>
    <background_color>
      <color red="255" green="200" blue="120"/>
    </background_color>
    <confirm_dialog>true</confirm_dialog>
    <confirm_message>Save configuration and REBOOT the NPort? All serial and TCP sessions will drop.</confirm_message>
  </widget>
