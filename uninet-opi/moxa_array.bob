<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Moxa NPort Array</name>
  <width>940</width>
  <height>700</height>
  <scripts>
    <script file="Scripts/LoadMoxaArray.py" check_connections="false"/>
  </scripts>
  <widget type="rectangle" version="2.0.0">
