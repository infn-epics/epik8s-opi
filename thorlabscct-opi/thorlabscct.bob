    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>textupdate_9</name>
    <pv_name>$(P):$(R):LastError</pv_name>
    <x>605</x>
    <y>50</y>
    <width>385</width>
    <height>20</height>
    <show_units>false</show_units>
    <tooltip>Full text: LastErrorLong (below)</tooltip>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>textupdate_10</name>
    <pv_name>$(P):$(R):LastErrorLong</pv_name>
    <x>10</x>
    <y>76</y>
    <width>980</width>
    <height>20</height>
    <show_units>false</show_units>
    <format>6</format>
    <vertical_alignment>1</vertical_alignment>
  </widget>
