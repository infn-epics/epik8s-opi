    <widget type="action_button" version="3.0.0">
      <name>action_button_26</name>
      <actions>
        <action type="write_pv">
          <description>Acquire</description>
          <pv_name>$(P):$(R):Acquire</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(P):$(R):Acquire</pv_name>
      <text>Acquire</text>
      <x>10</x>
      <y>165</y>
      <width>160</width>
      <height>28</height>
      <tooltip>Acquire one spectrum</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>action_button_27</name>
      <actions>
        <action type="write_pv">
          <description>Acquire dark</description>
          <pv_name>$(P):$(R):AcquireDark</pv_name>
          <value>1</value>
        </action>
      </actions>
      <pv_name>$(P):$(R):AcquireDark</pv_name>
      <text>Acquire dark</text>
      <x>195</x>
      <y>165</y>
      <width>160</width>
      <height>28</height>
      <tooltip>Close the shutter, update the dark spectrum, restore the shutter</tooltip>
    </widget>
