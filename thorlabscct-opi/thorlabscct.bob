  <widget type="xyplot" version="3.0.0">
    <name>spectrum_plot</name>
    <x>10</x>
    <y>345</y>
    <width>980</width>
    <height>405</height>
    <show_legend>false</show_legend>
    <x_axis>
      <title>Wavelength [nm]</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0"/>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="12.0"/>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Intensity [counts]</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0"/>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="12.0"/>
        </scale_font>
        <on_right>false</on_right>
        <color>
          <color red="0" green="0" blue="0"/>
        </color>
        <visible>true</visible>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>Spectrum</name>
        <x_pv>$(P):$(R):Wavelength</x_pv>
        <y_pv>$(P):$(R):Spectrum</y_pv>
        <err_pv/>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="90" blue="200"/>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>5</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
</display>
