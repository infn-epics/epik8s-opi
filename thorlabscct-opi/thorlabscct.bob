<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Thorlabs CCT $(P):$(R)</name>
  <width>1000</width>
  <height>760</height>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>label_1</name>
    <text>Thorlabs CCT spectrometer — $(P):$(R)</text>
    <x>0</x>
    <y>0</y>
    <width>1000</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="18.0"/>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255"/>
    </foreground_color>
    <background_color>
      <color red="40" green="60" blue="110"/>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="led" version="2.0.0">
    <name>led_2</name>
    <pv_name>$(P):$(R):Connected</pv_name>
    <x>10</x>
    <y>50</y>
    <width>20</width>
    <height>20</height>
    <off_color>
      <color red="200" green="0" blue="0"/>
    </off_color>
    <on_color>
      <color red="0" green="200" blue="0"/>
    </on_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>textupdate_3</name>
    <pv_name>$(P):$(R):Connected</pv_name>
    <x>35</x>
    <y>50</y>
    <width>110</width>
    <height>20</height>
    <show_units>false</show_units>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>label_4</name>
    <text>Device:</text>
    <x>160</x>
    <y>50</y>
    <width>55</width>
    <height>20</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0"/>
    </font>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>textupdate_5</name>
    <pv_name>$(P):$(R):DeviceId</pv_name>
    <x>215</x>
    <y>50</y>
    <width>200</width>
    <height>20</height>
    <show_units>false</show_units>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="led" version="2.0.0">
    <name>led_6</name>
    <pv_name>$(P):$(R):Busy</pv_name>
    <x>430</x>
    <y>50</y>
    <width>20</width>
    <height>20</height>
    <off_color>
      <color red="120" green="120" blue="120"/>
    </off_color>
    <on_color>
      <color red="255" green="180" blue="0"/>
    </on_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>textupdate_7</name>
    <pv_name>$(P):$(R):Busy</pv_name>
    <x>455</x>
    <y>50</y>
    <width>90</width>
    <height>20</height>
    <show_units>false</show_units>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>label_8</name>
